# Ключ авторизации GigaChat (Authorization key из личного кабинета developers.sber.ru)
GIGACHAT_AUTH_KEY=
# GIGACHAT_API_PERS — физлица, GIGACHAT_API_B2B / GIGACHAT_API_CORP — юрлица
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2-Max
# Путь к корневому сертификату НУЦ Минцифры (russian_trusted_root_ca.cer)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
